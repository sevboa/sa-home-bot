# Пользовательский юнит службы llm на Linux-ноде с постоянно поднятой Ollama
# (mycraft, container_backend="native" в [llm] — см. config.py::LlmConfig).
# Путь: ~/.config/systemd/user/sa-home-llm.service
# systemctl --user enable --now sa-home-llm
#
# Служба llm в registry.py помечена externally_managed=True глобально — этот
# флаг изначально появился ради winpc (wsl.exe не запускается из-под Session 0
# Windows-службы, живая находка 2026-07-23, см. deploy/llm-runner.ps1) и с тех
# пор так и остался общим для обеих платформ, чтобы не заводить platform-aware
# ветвление в node/supervisor.py ради одной службы. На Linux этого ограничения
# нет (systemd --user юнит — обычная пользовательская сессия, не Session 0),
# но раз sa-home-node всё равно её не спавнит, процесс поднимает этот
# отдельный юнит — по духу то же решение, что на Windows, только без
# PowerShell-цикла: Restart=on-failure у systemd делает то же самое проще.
#
# "llm" остаётся в [node].assignments на этой ноде — нужно для маршрутизации
# (node/app.py::build_router строит локальный PeerLink к settings.llm.socket
# по списку назначений), sa-home-node её не спавнит и не следит за ней.
[Unit]
Description=sa-home-llm (Альфред: диалог с локальной Ollama)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/sa-home-bot
ExecStart=%h/.local/bin/sa-home-bot --service llm --config %h/.config/sa-home-bot/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
